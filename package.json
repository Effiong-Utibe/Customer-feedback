{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format:frontend": "prettier --write resources/js/**/*.{ts,tsx,js,jsx} resources/css/**/*.css resources/views/**/*.blade.php vite.config.js",
    "check:frontend": "prettier --check resources/js/**/*.{ts,tsx,js,jsx} resources/css/**/*.css resources/views/**/*.blade.php vite.config.js",
    "format:backend": "php vendor/bin/pint app bootstrap config database routes tests",
    "check:backend": "php vendor/bin/pint --test app bootstrap config database routes tests"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@inertiajs/react": "^3.0.0",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "laravel-vite-plugin": "^2.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-blade": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.7"
  }
}
